<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="CaptchaChallengeRequest" strict="true">
        <property name="context" type="string"/>
        <property name="challengeUrl" type="string" description="URL the widget fetches its challenge from, for a provider that implements CaptchaChallengeUrlProviderPluginInterface."/>
    </transfer>

    <transfer name="CaptchaRequirementRequest" strict="true">
        <property name="context" type="string"/>
        <property name="ip" type="string"/>
        <property name="loginIdentifier" type="string"/>
    </transfer>

    <transfer name="CaptchaLoginForm" strict="true">
        <property name="formName" type="string"/>
        <property name="context" type="string"/>
        <property name="usernameFieldName" type="string"/>
        <property name="loginUrl" type="string"/>
        <property name="loginCheckRouteName" type="string"/>
        <property name="challengeUrl" type="string" description="Path of the challenge endpoint of the application that renders the form; the widget of a provider that implements CaptchaChallengeUrlProviderPluginInterface fetches its challenge from it."/>
        <property name="rejectionResponseType" type="string" description="How a Back Office or Merchant Portal submission rejected for its CAPTCHA is answered: one of the Zed CaptchaConfig::REJECTION_RESPONSE_TYPE_* values."/>
    </transfer>

    <transfer name="ZedUiFormResponse" strict="true">
    </transfer>

    <transfer name="CaptchaChallengeResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="widget" type="CaptchaWidget"/>
        <property name="messages" type="Message[]" singular="message"/>
    </transfer>

    <transfer name="CaptchaWidget" strict="true">
        <property name="tagName" type="string"/>
        <property name="attributes" type="array" singular="attribute" associative="true"/>
        <property name="nameAttribute" type="string"/>
        <property name="loaderTagName" type="string"/>
        <property name="scriptAssetPaths" type="string[]" singular="scriptAssetPath"/>
        <property name="scriptUrls" type="string[]" singular="scriptUrl"/>
    </transfer>

    <transfer name="CaptchaVerificationRequest" strict="true">
        <property name="payload" type="string"/>
        <property name="context" type="string"/>
        <property name="ip" type="string"/>
    </transfer>

    <transfer name="CaptchaVerificationResponse" strict="true">
        <property name="isValid" type="bool"/>
        <property name="isExpired" type="bool"/>
        <property name="messages" type="Message[]" singular="message"/>
        <property name="replayKey" type="string"/>
        <property name="replayExpiresAt" type="int"/>
        <property name="score" type="float"/>
        <property name="errorCode" type="string"/>
        <property name="isProviderUnavailable" type="bool"/>
    </transfer>

    <transfer name="Message">
        <property name="value" type="string"/>
        <property name="parameters" type="array" singular="parameters"/>
    </transfer>

    <transfer name="RedisConfiguration">
        <property name="dataSourceNames" type="array" singular="dataSourceNames"/>
        <property name="connectionCredentials" type="RedisCredentials"/>
        <property name="clientOptions" type="array" singular="clientOption" associative="true"/>
    </transfer>

    <transfer name="RedisCredentials">
        <property name="scheme" type="string"/>
        <property name="host" type="string"/>
        <property name="port" type="string"/>
        <property name="username" type="string"/>
        <property name="password" type="string"/>
        <property name="database" type="int"/>
        <property name="isPersistent" type="bool"/>
    </transfer>

    <transfer name="CaptchaChallengeDataRequest" strict="true">
        <property name="context" type="string"/>
        <property name="ip" type="string"/>
    </transfer>

    <transfer name="CaptchaChallengeDataResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="isRateLimited" type="bool"/>
        <property name="challengeData" type="string" description="JSON document of the challenge the widget fetches from the challenge URL."/>
        <property name="messages" type="Message[]" singular="message"/>
        <property name="retryAfterSeconds" type="int" description="Set with isRateLimited: the seconds after which the rate limit window of the request has ended at the latest."/>
    </transfer>

</transfers>
