{
    "name": "spryker/captcha",
    "type": "library",
    "description": "Captcha module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker-shop/agent-page-extension": "^1.3.0",
        "spryker-shop/customer-page-extension": "^1.10.0",
        "spryker/captcha-extension": "^1.0.0",
        "spryker/event-dispatcher-extension": "^1.0.0",
        "spryker/kernel": "^3.84.0",
        "spryker/log": "^3.0.0",
        "spryker/messenger": "^3.0.0",
        "spryker/redis": "^2.15.0",
        "spryker/security-gui-extension": "^1.6.0",
        "spryker/security-merchant-portal-gui-extension": "^1.6.0",
        "spryker/symfony": "^3.20.0",
        "spryker/transfer": "^3.27.0",
        "spryker/zed-ui": "^4.3.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/configuration": "*",
        "spryker/container": "*",
        "spryker/event-dispatcher": "*",
        "spryker/locale": "*",
        "spryker/propel": "*",
        "spryker/router": "*",
        "spryker/testify": "*",
        "spryker/translator": "*",
        "spryker/twig": "*"
    },
    "suggest": {
        "spryker-eco/captcha-altcha": "Provides the ALTCHA CAPTCHA provider plugin.",
        "spryker/container": "If you want to use the EventDispatcher plugins.",
        "spryker/event-dispatcher": "If you want to use the EventDispatcher plugins.",
        "spryker/gui": "Renders the Back Office form theme of the CAPTCHA field.",
        "spryker-shop/shop-ui": "Renders the Storefront form theme of the CAPTCHA field.",
        "spryker/router": "Use this module when you want to use the Router."
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/",
            "SprykerTest\\Client\\Captcha\\Helper\\": "tests/SprykerTest/Client/Captcha/_support/Helper/",
            "SprykerTest\\Zed\\Captcha\\Helper\\": "tests/SprykerTest/Zed/Captcha/_support/Helper/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerTest\\": "tests/SprykerTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
